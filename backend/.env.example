PORT=4000
# Host port used by Docker Compose; change it if port 4000 is occupied.
HOST_PORT=4000
ADMIN_TOKEN=replace-with-a-long-random-token
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com

# Set all SMTP values to send email. If they are omitted, alerts are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sahi Tareeqa <no-reply@example.com>

# Optional; primarily useful for isolated tests.
# DB_PATH=/absolute/path/to/sahi.db
